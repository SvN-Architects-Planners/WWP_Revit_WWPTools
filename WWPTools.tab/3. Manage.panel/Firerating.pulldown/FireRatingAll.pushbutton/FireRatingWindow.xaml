<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create Fire Rating Lines"
    Width="500" Height="300"
    MinWidth="420" MinHeight="260"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource WindowBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Create Fire Rating Lines"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="Draws detail lines along wall centerlines based on the FRR parameter value. If a line style is not found automatically, a mapping dialog will appear."
                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                       Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Wall count -->
        <TextBlock Grid.Row="1" x:Name="LblWallCount"
                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>

        <!-- FRR Param -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="FRR Instance Parameter:"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextBrush}" FontSize="13"/>
            <TextBox Grid.Column="1" x:Name="TxtFrrParam"
                     Height="32" Padding="8,4"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     FontSize="13" VerticalContentAlignment="Center"
                     ToolTip="The instance parameter name on walls that stores the FRR rating (e.g. FRR, FRR Walls)"/>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="4" x:Name="LblStatus"
                   Foreground="{StaticResource DangerBrush}" FontSize="12"
                   Margin="0,4,0,8" TextWrapping="Wrap"/>

        <!-- Buttons -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="BtnCancel"
                    Content="Cancel" Width="90" Height="34" FontSize="13"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    Foreground="{StaticResource TextBrush}" Cursor="Hand"/>
            <Button Grid.Column="3" x:Name="BtnRun"
                    Content="Create Lines" Width="110" Height="34"
                    FontSize="13" FontWeight="SemiBold"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
