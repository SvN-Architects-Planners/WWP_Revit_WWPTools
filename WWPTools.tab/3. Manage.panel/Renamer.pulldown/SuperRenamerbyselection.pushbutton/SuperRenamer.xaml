<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Super Renamer"
        Width="520"
        Height="740"
        MinWidth="420"
        MinHeight="640"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WWPTools.WpfUI;component/Themes/FlatTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="0,0,8,0" />
            </Style>
            <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Padding" Value="8,7,8,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0  header -->
            <RowDefinition Height="16" />     <!-- 1  gap -->
            <RowDefinition Height="Auto" />   <!-- 2  rename type -->
            <RowDefinition Height="10" />     <!-- 3  gap -->
            <RowDefinition Height="Auto" />   <!-- 4  category + load btn -->
            <RowDefinition Height="10" />     <!-- 5  gap -->
            <RowDefinition Height="Auto" />   <!-- 6  param panel (Collapsed) -->
            <RowDefinition Height="8" />      <!-- 7  gap -->
            <RowDefinition Height="Auto" />   <!-- 8  source label -->
            <RowDefinition Height="10" />     <!-- 9  gap -->
            <RowDefinition Height="Auto" />   <!-- 10 operation panel -->
            <RowDefinition Height="10" />     <!-- 11 gap -->
            <RowDefinition Height="Auto" />   <!-- 12 ignore groups -->
            <RowDefinition Height="*" />      <!-- 13 flex -->
            <RowDefinition Height="Auto" />   <!-- 14 buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtHeader"
                       Text="Super Renamer"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="TxtSubtitle"
                       Text="Find and replace names across your project."
                       Margin="0,4,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12" />
        </StackPanel>

        <!-- Rename type -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label x:Name="LblTarget" Grid.Column="0" Content="Rename:" />
            <ComboBox x:Name="CmbTarget" Grid.Column="1" />
        </Grid>

        <!-- Category / scope + Load button -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label x:Name="LblSelector" Grid.Column="0" Content="Category:" />
            <ComboBox x:Name="CmbCategory" Grid.Column="1" Margin="0,0,8,0" />
            <Button x:Name="BtnLoad"
                    Grid.Column="2"
                    Width="76"
                    Content="Load Params"
                    Visibility="Collapsed"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>

        <!-- Parameters panel (shown after Load) -->
        <Border x:Name="PnlParameters"
                Grid.Row="6"
                Visibility="Collapsed"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="PARAMETERS"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="10,8,10,4" />
                <ListBox x:Name="LstParameters"
                         Grid.Row="1"
                         Height="172"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="4,0,4,6" />
            </Grid>
        </Border>

        <!-- Source label -->
        <TextBlock x:Name="TxtSource"
                   Grid.Row="8"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="11"
                   Text="Source: All elements in document" />

        <!-- Operation panel -->
        <Border Grid.Row="10"
                Padding="14,12"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>

                <!-- Mode: Transform vs Overwrite -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="RbTransform"
                                 Content="Transform"
                                 IsChecked="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,20,0"
                                 Foreground="{StaticResource TextBrush}" />
                    <RadioButton x:Name="RbOverwrite"
                                 Content="Overwrite"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextBrush}" />
                </StackPanel>

                <!-- Transform: Find / Replace / Prefix / Suffix -->
                <Grid x:Name="PnlTransform">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Find:" />
                    <TextBox x:Name="TxtFind" Grid.Row="0" Grid.Column="1" />

                    <Label Grid.Row="2" Grid.Column="0" Content="Replace:" />
                    <TextBox x:Name="TxtReplace" Grid.Row="2" Grid.Column="1" />

                    <Label Grid.Row="4" Grid.Column="0" Content="Prefix:" />
                    <TextBox x:Name="TxtPrefix" Grid.Row="4" Grid.Column="1" />

                    <Label Grid.Row="6" Grid.Column="0" Content="Suffix:" />
                    <TextBox x:Name="TxtSuffix" Grid.Row="6" Grid.Column="1" />
                </Grid>

                <!-- Overwrite: single value field -->
                <Grid x:Name="PnlOverwrite" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Set to:" />
                    <TextBox x:Name="TxtOverwrite" Grid.Column="1" />
                </Grid>

            </StackPanel>
        </Border>

        <!-- Ignore groups -->
        <CheckBox x:Name="ChkIgnoreGroups"
                  Grid.Row="12"
                  IsChecked="True"
                  Content="Ignore elements in groups"
                  VerticalAlignment="Center"
                  Foreground="{StaticResource TextBrush}" />

        <!-- Buttons -->
        <DockPanel Grid.Row="14" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="BtnApply"
                        MinWidth="150"
                        Content="Preview &amp; Apply"
                        IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
