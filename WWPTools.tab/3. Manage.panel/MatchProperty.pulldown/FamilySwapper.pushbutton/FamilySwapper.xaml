<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Swapper"
        Width="560" Height="780"
        MinWidth="440" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.Resources>

        <Style TargetType="GroupBox">
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="Padding"         Value="8,6,8,8"/>
            <Setter Property="BorderBrush"     Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Padding"    Value="0,0,0,2"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#444444"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding"                  Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"              Value="#BBBBBB"/>
            <Setter Property="Height"                   Value="26"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"              Value="#BBBBBB"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding"     Value="10,4"/>
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
            <Setter Property="Background"  Value="#F5F5F5"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8E8E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RunButton" TargetType="Button">
            <Setter Property="Padding"          Value="0,9"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="Medium"/>
            <Setter Property="Background"       Value="#2B579A"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E4080"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="CanUserResizeRows"        Value="False"/>
            <Setter Property="HeadersVisibility"        Value="Column"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="BorderBrush"              Value="#CCCCCC"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="RowHeight"                Value="30"/>
            <Setter Property="ColumnHeaderHeight"       Value="28"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F0F0F0"/>
            <Setter Property="BorderBrush"     Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Foreground"      Value="#333333"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding"         Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="#D6E4F7"/>
                    <Setter Property="Foreground"  Value="#000000"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Family Swapper"
                       FontSize="17" FontWeight="Medium" Foreground="#222222"/>
            <TextBlock Text="Replace a titleblock family across sheets and remap instance parameters."
                       FontSize="11" Foreground="#777777" Margin="0,3,0,10"/>
            <Separator Background="#DDDDDD"/>
        </StackPanel>

        <!-- Scrollable config -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- Families -->
                <GroupBox Header="Families">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Content="Source:"
                               VerticalAlignment="Center"/>
                        <ComboBox x:Name="SourceFamilyCmb"
                                  Grid.Column="1" Grid.ColumnSpan="2"
                                  ToolTip="Auto-detected from current selection -- change to override"/>
                        <Label Grid.Row="2"
                               Content="Target:"
                               VerticalAlignment="Center"/>
                        <ComboBox x:Name="TargetFamilyCmb"
                                  Grid.Row="2" Grid.Column="1"
                                  ToolTip="Family to swap to"/>
                        <Button x:Name="SetTargetBtn"
                                Grid.Row="2" Grid.Column="2"
                                Content="Set target"
                                Margin="6,0,0,0"
                                ToolTip="Discover parameters from the selected target family"/>
                    </Grid>
                </GroupBox>

                <!-- Type Mapping -->
                <GroupBox Header="Type mapping">
                    <StackPanel>
                        <TextBlock Text="Each source type maps to a target type."
                                   FontSize="11" Foreground="#777777" Margin="0,0,0,6"/>
                        <DataGrid x:Name="TypeGrid" MinHeight="56" MaxHeight="180" Margin="0,0,0,6">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Source type"
                                    SelectedValueBinding="{Binding SourceType, UpdateSourceTrigger=LostFocus}"
                                    Width="*"/>
                                <DataGridComboBoxColumn Header="Target type"
                                    SelectedValueBinding="{Binding TargetType, UpdateSourceTrigger=LostFocus}"
                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AddTypeRowBtn"  Content="+ Add row"         Margin="0,0,6,0"/>
                            <Button x:Name="RemTypeRowBtn"  Content="&#8722; Remove selected"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Parameter Mapping -->
                <GroupBox Header="Parameter mapping">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="#777777" Margin="0,0,0,6"
                                   TextWrapping="Wrap"
                                   Text="Map old parameter names to new names. Leave target blank to keep the same name. Click Discover to populate dropdowns from the project."/>
                        <DataGrid x:Name="ParamGrid" MinHeight="56" MaxHeight="200" Margin="0,0,0,6">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Source parameter"
                                    SelectedValueBinding="{Binding OldName, UpdateSourceTrigger=LostFocus}"
                                    Width="*">
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="IsEditable" Value="True"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridComboBoxColumn Header="Target parameter"
                                    SelectedValueBinding="{Binding NewName, UpdateSourceTrigger=LostFocus}"
                                    Width="*">
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="IsEditable" Value="True"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DiscoverBtn"    Content="Discover from project" Margin="0,0,6,0"/>
                            <Button x:Name="AddParamRowBtn" Content="+ Add row"             Margin="0,0,6,0"/>
                            <Button x:Name="RemParamRowBtn" Content="&#8722; Remove selected"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Options -->
                <GroupBox Header="Options">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="Shift X (mm)  ·  + = right"/>
                            <TextBox x:Name="ShiftXBox" Text="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Shift Y (mm)  ·  + = up"/>
                            <TextBox x:Name="ShiftYBox" Text="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="Batch size"/>
                            <TextBox x:Name="BatchSizeBox" Text="40"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Run button -->
        <Button Grid.Row="2"
                x:Name="RunBtn"
                Content="Run swap"
                Style="{StaticResource RunButton}"
                Margin="0,10,0,6"/>

        <!-- Log -->
        <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1" Background="#F7F7F7">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="6,5"
                     Foreground="#333333"/>
        </Border>

    </Grid>
</Window>
