<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parking Count in Room/Area"
        Height="660"
        Width="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="#F3F5F7">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3F9AD9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F9AD9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="26.5"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2E87C5"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2E87C5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Border Background="#FFFFFF"
                BorderBrush="#D7DEE6"
                BorderThickness="1"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Select rooms/areas with parking"
                           Margin="0,0,0,10"
                           Foreground="#6B7280"
                           FontWeight="SemiBold"/>

                <!-- Three-column main area -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: Spaces list -->
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Rooms / areas"
                                   Margin="0,0,0,6"
                                   Foreground="#6B7280"
                                   FontWeight="SemiBold"/>
                        <ListBox Name="RoomsList" SelectionMode="Extended"/>
                    </DockPanel>

                    <!-- Column 1: Families list -->
                    <DockPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Parking families to include"
                                   Margin="0,0,0,6"
                                   Foreground="#6B7280"
                                   FontWeight="SemiBold"/>
                        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="AddFamilyText"
                                     Grid.Column="0"
                                     Height="30"
                                     Margin="0,0,6,0"
                                     VerticalContentAlignment="Center"/>
                            <Button Name="AddFamilyButton"
                                    Grid.Column="1"
                                    Content="+ Add"
                                    Style="{StaticResource SmallButtonStyle}"/>
                        </Grid>
                        <ListBox Name="FamiliesList" SelectionMode="Extended"/>
                    </DockPanel>

                    <!-- Column 2: Options -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Target text parameter to write"
                                   Margin="0,0,0,6"
                                   Foreground="#6B7280"
                                   FontWeight="SemiBold"/>
                        <ComboBox Name="RoomParamCombo" Margin="0,0,0,12"/>

                        <TextBlock Text="Parking count source"
                                   Margin="0,0,0,6"
                                   Foreground="#6B7280"
                                   FontWeight="SemiBold"/>
                        <ComboBox Name="CountParamCombo" Margin="0,0,0,16"/>

                        <CheckBox Name="BreakdownCheckBox"
                                  Content="Include parking type breakdowns"
                                  Margin="0,0,0,10"/>

                        <TextBlock Name="TypeSourceLabel"
                                   Text="Type parameter"
                                   Margin="0,0,0,6"
                                   Foreground="#6B7280"
                                   FontWeight="SemiBold"
                                   Visibility="Collapsed"/>
                        <ComboBox Name="TypeSourceCombo"
                                  Margin="0,0,0,0"
                                  Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                    <Image Name="LogoImage"
                           DockPanel.Dock="Left"
                           Width="56"
                           Height="56"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Left"
                           IsHitTestVisible="False"/>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Name="OkButton"
                                Content="Run"
                                Width="110"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Name="CancelButton"
                                Content="Cancel"
                                Width="110"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
