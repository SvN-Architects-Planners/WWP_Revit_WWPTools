<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Revisions Beta"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#E5EAF0" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Height" Value="26.5" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#D6DEE8" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B8C6D6" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderTitle"
                       Text="Manual Revisions Beta"
                       FontSize="18"
                       FontWeight="Bold" />
            <TextBlock x:Name="SheetLabel"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="12"
                       Text="Beta formatter using one multiline text parameter for the full revision block." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" MinWidth="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="16"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,0,0,10"
                                   FontWeight="Bold"
                                   Text="Formatted Block" />

                        <Label Grid.Row="1" Grid.Column="0" Content="Text parameter" />
                        <ComboBox x:Name="CmbBlockParam" Grid.Row="1" Grid.Column="1" Margin="8,0,0,8" />

                        <Label Grid.Row="2" Grid.Column="0" Content="Date width (mm)" />
                        <TextBox x:Name="TxtDateWidth" Grid.Row="2" Grid.Column="1" Margin="8,0,0,8" />

                        <Label Grid.Row="3" Grid.Column="0" Content="Description width (mm)" />
                        <TextBox x:Name="TxtDescWidth" Grid.Row="3" Grid.Column="1" Margin="8,0,0,8" />

                        <Label Grid.Row="4" Grid.Column="0" Content="Column sets" />
                        <TextBox x:Name="TxtColumnCount" Grid.Row="4" Grid.Column="1" Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Padding="16,14"
                        Background="#EAF4FB"
                        BorderBrush="#C7DDEE"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Target titleblock" />
                        <ComboBox x:Name="CmbTargetTitleblock" Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" />

                        <CheckBox x:Name="ChkOnlyOverrideNeeded"
                                  Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  IsChecked="True">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Only switch to the selected target titleblock when the formatted revisions need more than one column set." />
                        </CheckBox>

                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="The tool writes one multiline text block that includes date and description columns side by side. Width inputs are in millimeters and are converted to approximate text capacity." />

                        <TextBlock x:Name="TxtMappingInfo"
                                   Grid.Row="3"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="Select sheets and review the override summary." />
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#D7DEE8"
                          ShowsPreview="True"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Sheets to Update"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="BtnSelectAll"
                                MinWidth="90"
                                Margin="0,0,8,0"
                                Content="Select All"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="BtnClearSelection"
                                MinWidth="90"
                                Content="Clear"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </DockPanel>
                <ListBox x:Name="SheetsList"
                         Grid.Row="1"
                         SelectionMode="Extended"
                         MinHeight="260" />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="BtnApply"
                        MinWidth="130"
                        Content="Update Sheets"
                        IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
