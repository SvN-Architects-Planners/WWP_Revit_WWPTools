<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Import Shared Parameters"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="12"
        Background="{StaticResource WindowBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFD9DEE7"/>
        <SolidColorBrush x:Key="TitleBrush" Color="#FF152033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF5F6B7A"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF175CD3"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF1849A9"/>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#FFC8D0DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFC5CCD8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF0F3F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="132"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE4E7EC"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFFAFBFC"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF1F3F6"/>
            <Setter Property="BorderBrush" Value="#FFD9DEE7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFDCE9FC"/>
                    <Setter Property="Foreground" Value="#FF101828"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridComboStyle" TargetType="ComboBox">
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Bulk Import Shared Parameters"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}"/>
            <TextBlock Margin="0,5,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Text="Create rows manually or import them from Excel. Every imported row remains editable before anything is added to Revit."/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,14"
                Padding="14"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}"
                           Text="Shared Parameters file"/>
                <TextBox x:Name="SharedFileBox"
                         Grid.Column="1"
                         IsReadOnly="True"
                         Foreground="{StaticResource MutedBrush}"/>
                <Button x:Name="BrowseButton"
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        Content="Choose another..."/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="14,12,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               Text="Parameter bindings"/>
                    <TextBlock x:Name="ParameterCountText"
                               Grid.Column="1"
                               Foreground="{StaticResource MutedBrush}"/>
                </Grid>

                <DataGrid x:Name="ParameterGrid" Grid.Row="1" Margin="14,0,14,10">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="Shared parameter"
                                                SelectedValueBinding="{Binding Parameter, UpdateSourceTrigger=PropertyChanged}"
                                                EditingElementStyle="{StaticResource GridComboStyle}"
                                                Width="3*"/>
                        <DataGridComboBoxColumn Header="Instance / Type"
                                                SelectedValueBinding="{Binding Binding, UpdateSourceTrigger=PropertyChanged}"
                                                EditingElementStyle="{StaticResource GridComboStyle}"
                                                Width="1.2*"/>
                        <DataGridComboBoxColumn Header="Parameter group"
                                                SelectedValueBinding="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                                                EditingElementStyle="{StaticResource GridComboStyle}"
                                                Width="2.2*"/>
                        <DataGridComboBoxColumn Header="Category"
                                                SelectedValueBinding="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                EditingElementStyle="{StaticResource GridComboStyle}"
                                                Width="2.2*"/>
                        <DataGridTextColumn Header="Import notes"
                                            Binding="{Binding ImportNotes}"
                                            IsReadOnly="True"
                                            Width="2.8*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2"
                        Margin="14,0,14,10"
                        Padding="10"
                        Background="#FFF7F9FC"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource TitleBrush}"
                                       Text="Bulk edit selected rows"/>
                            <TextBlock Margin="10,0,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Ctrl/Shift-click rows in the table, then choose one value to apply."/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Field"/>
                            <ComboBox x:Name="BulkFieldCombo"
                                      Grid.Column="1"
                                      MinHeight="32"
                                      Margin="0,0,12,0"
                                      AutomationProperties.Name="Bulk edit field"/>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Value"/>
                            <ComboBox x:Name="BulkValueCombo"
                                      Grid.Column="3"
                                      MinHeight="32"
                                      Margin="0,0,10,0"
                                      IsTextSearchEnabled="True"
                                      AutomationProperties.Name="Bulk edit value"/>
                            <CheckBox x:Name="OnlyMissingCheckBox"
                                      Grid.Column="4"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      IsChecked="True"
                                      Content="Only fill missing values"/>
                            <Button x:Name="ApplySelectedButton"
                                    Grid.Column="5"
                                    Content="Apply to selected"/>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            Margin="14,0,14,14"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="ExcelImportButton" Content="Import rows from Excel..." Margin="0,0,8,0"/>
                    <Button x:Name="AddParametersButton"
                            Content="+ Add parameters..."
                            Margin="0,0,8,0"
                            ToolTip="Choose several shared parameters at once and add one selected row for each."/>
                    <Button x:Name="AddRowButton" Content="+ Add row" Margin="0,0,8,0"/>
                    <Button x:Name="DuplicateRowButton" Content="Duplicate selected" Margin="0,0,8,0"/>
                    <Button x:Name="RemoveRowButton" Content="Remove selected"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="2,10,2,10"
                   Foreground="{StaticResource MutedBrush}"
                   Text="Excel rows are editable. Existing bindings keep their current categories; selected categories are added."/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,8,0"/>
            <Button x:Name="ImportButton"
                    Content="Import parameters"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
